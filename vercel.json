{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/nc.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(assets|previews)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://shop.nextchaptergide.site/",
      "permanent": false
    },
    {
      "source": "/quiz",
      "destination": "https://shop.nextchaptergide.site/quiz",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://shop.nextchaptergide.site/app",
      "permanent": false
    },
    {
      "source": "/calculator",
      "destination": "https://shop.nextchaptergide.site/calculator",
      "permanent": false
    },
    {
      "source": "/choose",
      "destination": "https://shop.nextchaptergide.site/choose",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "https://shop.nextchaptergide.site/privacy",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "https://nextchaptergide.site/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "https://nextchaptergide.site/",
      "permanent": true
    },
    {
      "source": "/crew",
      "destination": "https://sidequestcrew.space/",
      "permanent": false
    },
    {
      "source": "/crew/(.*)",
      "destination": "https://sidequestcrew.space/",
      "permanent": false
    },
    {
      "source": "/side-quest-crew/(.*)",
      "destination": "https://sidequestcrew.space/",
      "permanent": false
    }
  ]
}